#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"
SOCKET_PATH="/tmp/rlocal/wacli/wacli.sock"
MAIN_MACHINE="rdzero"

if [[ "$(hostname)" == "$MAIN_MACHINE" ]]; then
    # Main desktop: run CLI directly
    cd "$SCRIPT_DIR"/cli

    CACHE_DIR="$HOME/.cache/rlocal/wacli"
    CACHE_FILE="$CACHE_DIR/build_sha"
    mkdir -p "$CACHE_DIR"

    CURRENT_SHA=$(git rev-parse HEAD)
    CACHED_SHA=$(cat "$CACHE_FILE" 2>/dev/null || echo "")

    if [ "$CURRENT_SHA" != "$CACHED_SHA" ] || [ ! -f "./wacli" ]; then
        echo "Build cache miss, rebuilding..."
        go build
        echo "$CURRENT_SHA" > "$CACHE_FILE"
    fi

    exec ./wacli
else
    # Other machines: forward local socket to main machine via SSH
    REMOTE_SOCKET="/tmp/rlocal/wacli/wacli.sock"
    mkdir -p "$(dirname "$SOCKET_PATH")"
    rm -f "$SOCKET_PATH"
    exec ssh -N -L "$SOCKET_PATH:$REMOTE_SOCKET" "$MAIN_MACHINE"
fi