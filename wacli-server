#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"
SOCKET_PATH="/tmp/rlocal/wacli/wacli.sock"
MAIN_MACHINE="rdzero"

if [[ "$(hostname)" == "$MAIN_MACHINE" ]]; then
    # Main desktop: run CLI directly
    cd "$SCRIPT_DIR"/cli
    exec ./wacli
else
    # Other machines: forward local socket to main machine via SSH
    REMOTE_SOCKET="/tmp/rlocal/wacli/wacli.sock"
    mkdir -p "$(dirname "$SOCKET_PATH")"
    rm -f "$SOCKET_PATH"
    exec ssh -N -L "$SOCKET_PATH:$REMOTE_SOCKET" "$MAIN_MACHINE"
fi